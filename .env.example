# 复制为 .env 后填写。不要提交 .env。
# 建议只放 qun.qq.com 需要的最小 Cookie：skey、p_skey、p_uin、uin。
QQ_VALHALLA_COOKIE="skey=请填入; p_skey=请填入; p_uin=o123456; uin=o123456"

# 必填：只归档这些群。支持逗号、分号或空格分隔。
QQ_VALHALLA_GROUP_IDS="123456789,987654321"

# 可选项
QQ_VALHALLA_DB="data/valhalla.sqlite3"
QQ_VALHALLA_ARCHIVE_DIR="archive"
QQ_VALHALLA_TIMEOUT="15"
QQ_VALHALLA_PAGE_SIZE="40"
QQ_VALHALLA_POLL_SECONDS="300"
QQ_VALHALLA_ACCEPT_LANGUAGE="zh-CN,zh;q=0.9"

# PM2 dashboard 静态服务配置
QQ_VALHALLA_DASHBOARD_HOST="127.0.0.1"
QQ_VALHALLA_DASHBOARD_PORT="8958"
